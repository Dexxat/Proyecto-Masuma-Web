# Secretos de las Edge Functions. NUNCA se suben al repositorio ni se pegan en chats.
# Se cargan con:  supabase secrets set NOMBRE=valor ...   (o desde el panel de Supabase > Edge Functions > Secrets)
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solos.

SITE_URL=https://www.masuma.com.ar          # a donde vuelve el cliente tras pagar

# Mercado Pago (credenciales de PRUEBA primero)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true

# PayPal (sandbox primero)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox                          # sandbox | live

# Mails (ver docs/EMAILS.md)
EMAIL_API_KEY=
EMAIL_FROM="MASUMA <no-responder@tu-dominio>"
EMAIL_ADMIN_TO=
SUPPORT_EMAIL=
BRAND_NAME=MASUMA
CRON_SECRET=
